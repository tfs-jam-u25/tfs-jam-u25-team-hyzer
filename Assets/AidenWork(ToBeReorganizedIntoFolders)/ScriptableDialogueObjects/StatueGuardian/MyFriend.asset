  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 078af4cba15394a46953dc9add841154, type: 3}
  m_Name: MyFriend
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Watcher of the Castle
    text: What brings you to this old Watcher's haunt?
    portrait: {fileID: -469398985, guid: 487b6b9c8454eee4186f591c5b530a73, type: 3}
    voiceClip: {fileID: 0}
  - speakerName: Reaper
    text: I've been sent here for the Harvest.....
    portrait: {fileID: -1698313499, guid: ab58585a335c9a946b8fcdd32ffc1f00, type: 3}
    voiceClip: {fileID: 0}
  - speakerName: Watcher of the Castle
    text: Nevermind. My friend, the Keeper is no longer with us. His spirit has been
      stolen.
    portrait: {fileID: -469398985, guid: 487b6b9c8454eee4186f591c5b530a73, type: 3}
    voiceClip: {fileID: 0}
  - speakerName: Watcher of the Castle
    text: Retieve his soul, make him whole, and I will watch over you in times of
      great need.
    portrait: {fileID: -469398985, guid: 487b6b9c8454eee4186f591c5b530a73, type: 3}
    voiceClip: {fileID: 0}
